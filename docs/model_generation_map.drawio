<mxfile host="app.diagrams.net"><diagram name="Model lineage tree" id="genmaptree"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="PDAC / solid-tumour invasion &amp;mdash; model lineage tree.   Left lane = BIOLOGY (what the cell/organoid does).   Right lane = PHYSICS (the equations).   Spine = each version's limitation motivates the next." style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1170" height="30" as="geometry"/></mxCell><mxCell id="hbio" value="&amp;#129516; BIOLOGY / cell modelling&lt;br&gt;&lt;b&gt;read down this lane &amp;mdash; for Prof. Kolade&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5FA05A;strokeColor=#5FA05A;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="430" height="46" as="geometry"/></mxCell><mxCell id="htrk" value="LINEAGE&lt;br&gt;(tree spine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="210" height="46" as="geometry"/></mxCell><mxCell id="hphy" value="&amp;#8721; PHYSICS / equations&lt;br&gt;&lt;b&gt;read down this lane &amp;mdash; for Prof. Hongbo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B7FBF;strokeColor=#5B7FBF;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="470" height="46" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;G1 &amp;middot; V0&amp;ndash;V4&lt;/b&gt;&lt;br&gt;&lt;i&gt;[FROZEN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;development archive (history, not results)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#9AA0A6;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="240" width="210" height="135" as="geometry"/></mxCell><mxCell id="g1_b" value="&lt;b&gt;The question forming.&lt;/b&gt; How does a cell mechanically talk to&lt;br&gt;collagen? Prototyped, in order: SLS relaxation &amp;rarr; a few single&lt;br&gt;fibres &amp;rarr; first fibre&amp;ndash;fibre crosslinks &amp;rarr; a first moving cell &amp;rarr;&lt;br&gt;first &amp;ldquo;does the matrix stay deformed after unloading?&amp;rdquo; test.&lt;br&gt;&lt;i&gt;Kept only to show how the idea evolved.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5FA05A;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="430" height="235" as="geometry"/></mxCell><mxCell id="g1_p" value="(archived prototypes &amp;mdash; no single active equation set)&lt;br&gt;SLS hypothesis was inserted &lt;i&gt;before&lt;/i&gt; elastic collagen +&lt;br&gt;crosslink transmission were validated &amp;mdash; hence corrected in G2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#5B7FBF;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="470" height="235" as="geometry"/></mxCell><mxCell id="g1_lb" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g1" target="g1_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g1_lp" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g1" target="g1_p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g1_fb" value="Feedback / notes (date / who / point):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="1170" height="40" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;G2 &amp;middot; V2&amp;ndash;V4&lt;/b&gt;&lt;br&gt;&lt;i&gt;[FROZEN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;corrected elastic bead&amp;ndash;spring baseline (92 tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#9AA0A6;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="585" width="210" height="135" as="geometry"/></mxCell><mxCell id="g2_b" value="&lt;b&gt;One cell grips collagen; the pull spreads.&lt;/b&gt; A local 5 nN pull&lt;br&gt;reaches distant fibres &lt;i&gt;only&lt;/i&gt; through fibre&amp;ndash;fibre crosslinks&lt;br&gt;(21.6% larger response with links). Released cell then migrates&lt;br&gt;(0.28 &amp;micro;m/min). Plasticity tested &amp;mdash; and honestly &lt;i&gt;not&lt;/i&gt; seen at 5 nN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5FA05A;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="430" height="235" as="geometry"/></mxCell><mxCell id="g2_p" value="&lt;b&gt;Overdamped bead (the shared engine):&lt;/b&gt;&lt;br&gt;&amp;zeta; &amp;middot; dr_i/dt = F_stretch(i) + F_bend(i) + F_clutch(i)&lt;br&gt;Elastic stretch (Hooke) + standard elastic bend.&lt;br&gt;&lt;i&gt;No SLS, no plasticity.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#5B7FBF;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="740" y="535" width="470" height="235" as="geometry"/></mxCell><mxCell id="g2_lb" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g2" target="g2_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g2_lp" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g2" target="g2_p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g2_fb" value="Feedback / notes (date / who / point):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="1170" height="40" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;G3 &amp;middot; spheroid&lt;/b&gt;&lt;br&gt;&lt;i&gt;[FROZEN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;contractile spheroid &amp;rarr; radial collagen (aster)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#9AA0A6;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="930" width="210" height="135" as="geometry"/></mxCell><mxCell id="g3_b" value="&lt;b&gt;Reel collagen into a radial aster.&lt;/b&gt; A round spheroid not&lt;br&gt;touching collagen at t=0 sends protrusions out in &lt;i&gt;all&lt;/i&gt; directions,&lt;br&gt;grips fibres and reels them inward &amp;rarr; disordered tangle becomes&lt;br&gt;a radial pattern (TACS-3-like; radial order &amp;minus;0.49 &amp;rarr; &amp;minus;0.04).&lt;br&gt;&lt;i&gt;Symmetric, no prescribed side; the point is matrix remodelling.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5FA05A;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="430" height="235" as="geometry"/></mxCell><mxCell id="g3_p" value="&lt;b&gt;Persistent material point:&lt;/b&gt;  x_j = (1&amp;minus;&amp;alpha;_j) r_a + &amp;alpha;_j r_b&lt;br&gt;&lt;b&gt;Bell off-rate (clutch):&lt;/b&gt;  r_off = r_off^0 &amp;middot; exp(|F_j| / F_b)&lt;br&gt;&lt;b&gt;Gaussian projection:&lt;/b&gt;  w_ij &amp;prop; exp(&amp;minus;d&amp;sup2; / 2&amp;sigma;&amp;sup2;), &amp;Sigma; w = 1&lt;br&gt;&lt;b&gt;Rigid body:&lt;/b&gt;  &amp;gamma;_c &amp;middot; dr_c/dt = &amp;minus;&amp;Sigma;_j F_j&lt;br&gt;&lt;b&gt;Contact penalty:&lt;/b&gt;  F_contact = k &amp;middot; &amp;delta; &amp;middot; (r_i&amp;minus;r_c)/d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#5B7FBF;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="740" y="880" width="470" height="235" as="geometry"/></mxCell><mxCell id="g3_lb" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g3" target="g3_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g3_lp" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g3" target="g3_p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g3_fb" value="Feedback / notes (date / who / point):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1121" width="1170" height="40" as="geometry"/></mxCell><mxCell id="g4v1" value="&lt;b&gt;G4 v1 &amp;middot; A&amp;ndash;D&lt;/b&gt;&lt;br&gt;&lt;i&gt;[FROZEN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;interactive calibration (short-time)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#9AA0A6;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="1275" width="210" height="135" as="geometry"/></mxCell><mxCell id="g4v1_b" value="&lt;b&gt;Calibrate the single cell, four steps.&lt;/b&gt; A: tune matrix&lt;br&gt;stiffness. B: show a non-contact fibre moves &lt;i&gt;only&lt;/i&gt; via crosslinks.&lt;br&gt;C: clutches stochastically slip &amp;amp; let go. D: release the cell so&lt;br&gt;it can crawl with no prescribed direction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5FA05A;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="1225" width="430" height="235" as="geometry"/></mxCell><mxCell id="g4v1_p" value="Same overdamped core + Bell clutch kinetics.&lt;br&gt;12 &lt;i&gt;independent&lt;/i&gt; clutches per material point.&lt;br&gt;(2&amp;ndash;5 min horizon &amp;mdash; changes came out sub-pixel.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#5B7FBF;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="740" y="1225" width="470" height="235" as="geometry"/></mxCell><mxCell id="g4v1_lb" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g4v1" target="g4v1_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g4v1_lp" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g4v1" target="g4v1_p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g4v1_fb" value="Feedback / notes (date / who / point):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1466" width="1170" height="40" as="geometry"/></mxCell><mxCell id="g4v2" value="&lt;b&gt;G4 v2 &amp;middot; A&amp;ndash;D&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT]&lt;/i&gt;&lt;br&gt;&lt;br&gt;long-time + visible clutch failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="1620" width="210" height="135" as="geometry"/></mxCell><mxCell id="g4v2_b" value="&lt;b&gt;Watch the same cell for 2 h (like the imaging).&lt;/b&gt; Individual&lt;br&gt;clutches visibly load, slip and fully detach; fibres recoil.&lt;br&gt;Compare 12 &lt;i&gt;independent&lt;/i&gt; clutches vs a &lt;i&gt;shared-load&lt;/i&gt; team that&lt;br&gt;fails as a cascade. Fixed / moving / mobile-ECM controls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5FA05A;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="1570" width="430" height="235" as="geometry"/></mxCell><mxCell id="g4v2_p" value="&lt;b&gt;Shared load on i of N bound clutches at one site:&lt;/b&gt;&lt;br&gt;f_i = F_site / i&lt;br&gt;r_i = i &amp;middot; k_off^0 &amp;middot; exp( F_site / (i &amp;middot; F_b) )&lt;br&gt;g_i = (N&amp;minus;i) &amp;middot; k_on   (rebinding can rescue the cluster)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#5B7FBF;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="740" y="1570" width="470" height="235" as="geometry"/></mxCell><mxCell id="g4v2_lb" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g4v2" target="g4v2_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g4v2_lp" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g4v2" target="g4v2_p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g4v2_fb" value="Feedback / notes (date / who / point):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1811" width="1170" height="40" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;G5 &amp;middot; organoid&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PLANNED / PROTOTYPE]&lt;/i&gt;&lt;br&gt;&lt;br&gt;multicellular tumour organoid invasion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7D3;strokeColor=#C06157;align=center;verticalAlign=middle;spacing=6;fontSize=11;fontStyle=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="1965" width="210" height="135" as="geometry"/></mxCell><mxCell id="g5_b" value="&lt;b&gt;A whole organoid, not one cell.&lt;/b&gt; ~200 &amp;micro;m, ~19&amp;ndash;43 motor&amp;ndash;&lt;br&gt;clutch cells held together by &lt;i&gt;cell&amp;ndash;cell adhesion&lt;/i&gt;. Together they&lt;br&gt;pull the collagen radial, then &lt;i&gt;invade&lt;/i&gt; outward. The balance of&lt;br&gt;cell&amp;ndash;cell adhesion vs cell&amp;ndash;matrix traction decides &lt;b&gt;collective&lt;br&gt;advance vs single-cell escape&lt;/b&gt; (grounded in Kolade/Gloria movies)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5FA05A;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="1915" width="430" height="235" as="geometry"/></mxCell><mxCell id="g5_p" value="&lt;b&gt;Force balance per bead:&lt;/b&gt;&lt;br&gt;&amp;zeta; dr_i/dt = F_stretch + F_bend + F_crosslink + F_repulsion + F_active&lt;br&gt;&lt;b&gt;Cell m reaction (invasion):&lt;/b&gt;  &amp;gamma;_c dr_c^(m)/dt = &amp;minus;&amp;Sigma;_j F_j^(m) + &amp;Sigma; F_cc&lt;br&gt;&lt;b&gt;New: cell&amp;ndash;cell&lt;/b&gt;  F_cc = soft attract&amp;ndash;repel  U(|r_a &amp;minus; r_b|)&lt;br&gt;&lt;b&gt;Stage E plasticity:&lt;/b&gt; crosslink Bell rupture + re-weld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEF9;strokeColor=#5B7FBF;align=left;verticalAlign=top;spacing=8;spacingLeft=10;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="740" y="1915" width="470" height="235" as="geometry"/></mxCell><mxCell id="g5_lb" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g5" target="g5_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g5_lp" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#B0B0B0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g5" target="g5_p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g5_fb" value="Advisor sign-off PENDING &amp;mdash; Q1: exact cell&amp;ndash;cell adhesion form?   Q2: swirling not seen in Kolade lab &amp;mdash; don't build on Saraswathibhatla swirling.   (date / who / point):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="2156" width="1170" height="40" as="geometry"/></mxCell><mxCell id="e_g1_g2" value="&amp;#9888; correct BCs, units, coupling; drop premature SLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C06157;strokeWidth=2;fontColor=#C06157;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_g2_g3" value="&amp;#9888; migration direction still prescribed (imposed imbalance)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C06157;strokeWidth=2;fontColor=#C06157;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_g3_g4v1" value="&amp;#9888; calibrate stiffness; prove indirect path; release the cell" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C06157;strokeWidth=2;fontColor=#C06157;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g3" target="g4v1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_g4v1_g4v2" value="&amp;#9888; observe 2 h; resolve individual clutch failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C06157;strokeWidth=2;fontColor=#C06157;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g4v1" target="g4v2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_g4v2_g5" value="&amp;#9888; single cell &amp;rarr; multicellular organoid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C06157;strokeWidth=2;fontColor=#C06157;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g4v2" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tblA" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Table 1 &amp;middot; Two force couplings &amp;mdash; does either break?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;font-size:9px&quot;&gt;clears up the &amp;ldquo;which spring ruptures?&amp;rdquo; confusion (CLAUDE.md &amp;sect;5: Bell-on-clutch &amp;ne; Bell-on-crosslinker)&lt;/span&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#5B7FBF;color:#fff&quot;&gt;Coupling&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#5B7FBF;color:#fff&quot;&gt;Breaks?&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#5B7FBF;color:#fff&quot;&gt;Governed by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;Cell&amp;ndash;fibre clutch&lt;/b&gt;&lt;br&gt;(cell grips collagen)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;No&lt;/b&gt; (default):&lt;br&gt;constant 12 nN&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;Prescribed traction (total_pull_force).&lt;br&gt;Opt-in slip mode: Bell k_off^0&amp;middot;exp(F/F_b),&lt;br&gt;k_off^0=0.018/s, F_b=1.5 nN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;Crosslinker&lt;/b&gt;&lt;br&gt;(fibre&amp;ndash;fibre weld)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;Yes&lt;/b&gt; &amp;mdash; Stage E&lt;br&gt;(plasticity=True)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;Bell rupture k_off^0&amp;middot;exp(F/F_b),&lt;br&gt;k_off^0=2e-4/s, F_b=3.0 nN;&lt;br&gt;re-welds at current crossings &amp;rarr; irreversible&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;Fibre segment&lt;/b&gt;&lt;br&gt;(bead&amp;ndash;bead spring)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;Elastic Hooke  F = &amp;kappa;_s &amp;middot; ext&lt;br&gt;(&amp;kappa;_s = 4e-3 N/m)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B7FBF;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="190" width="460" height="250" as="geometry"/></mxCell><mxCell id="tblB" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Table 2 &amp;middot; Generation status at a glance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;font-size:9px&quot;&gt;nothing is overwritten &amp;mdash; every version is preserved (VERSION_MAP.md)&lt;/span&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#9AA0A6;color:#fff&quot;&gt;Gen&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#9AA0A6;color:#fff&quot;&gt;What it is&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#9AA0A6;color:#fff&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;G1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;V0&amp;ndash;V4 history archive&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;frozen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;G2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;corrected elastic baseline (engine)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;frozen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;G3&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;spheroid &amp;rarr; radial aster&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;frozen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;G4 v1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;single-cell calibration&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;frozen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;G4 v2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;2 h + visible clutch failure&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;&lt;b&gt;CURRENT&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;G5&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;organoid remodel + invade&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;planned / prototype&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="460" width="460" height="210" as="geometry"/></mxCell><mxCell id="tblC" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Table 3 &amp;middot; Stage A&amp;ndash;F roadmap (orthogonal to G1&amp;ndash;G5)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;font-size:9px&quot;&gt;the mechanics-first staging inside the CURRENT focus (CLAUDE.md &amp;sect;3b) &amp;mdash; not separate models&lt;/span&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:9px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#5FA05A;color:#fff&quot;&gt;Stage&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#5FA05A;color:#fff&quot;&gt;Adds&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;background:#5FA05A;color:#fff&quot;&gt;Gate&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;A&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;minimal fibre network&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;forces balance at rest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;B&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;overdamped dynamics&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;alignment from pull alone&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;C&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;fixed rigid cell + Gaussian&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;material-point + FOI response&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;D&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;moving attachment sites&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;attachment tracks deforming fibre&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;E&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;mobile rigid cell&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;cell migrates; reactions balance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;F&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;deformable cell / richer biology&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbb;padding:3px;vertical-align:top&quot;&gt;only after A&amp;ndash;E validate&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5FA05A;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="690" width="460" height="220" as="geometry"/></mxCell><mxCell id="howto" value="&lt;b&gt;How to use&lt;/b&gt;&lt;br&gt;Open in VS Code &lt;i&gt;Draw.io Integration&lt;/i&gt; or app.diagrams.net.&lt;br&gt;&amp;bull; Kolade reads the green (left) lane; Hongbo reads the blue (right) lane.&lt;br&gt;&amp;bull; After a meeting: type the comment into the yellow strip under the right generation (date / who / point).&lt;br&gt;&amp;bull; New generation? Copy a band, recolour the trunk, extend the spine arrow.&lt;br&gt;&amp;bull; Text mirror: &lt;i&gt;docs/model_generation_map.md&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#4FC3F7;align=left;verticalAlign=top;spacing=8;fontSize=10;size=14;" vertex="1" parent="1"><mxGeometry x="1250" y="930" width="460" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>